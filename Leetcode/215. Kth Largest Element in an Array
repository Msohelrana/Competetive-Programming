class Solution {
public:
    int findKthLargest(vector<int>& nums, int k) {
        int n=nums.size();
        int r=n-k,ans;
        map<int,int>mp;
        for(int i=0;i<n;i++){
            mp[nums[i]]++;
        }
        for(auto x:mp){
            r-=x.second;
            if(r<0){
                ans=x.first;
                break;
            }
        }
        return ans;
    }
};
